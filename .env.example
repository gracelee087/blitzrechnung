# Copy to .env.local to override the defaults.

# devnet (test money, default) or mainnet-beta (real money)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional: a faster RPC (e.g. from Helius or QuickNode). The public devnet RPC is rate-limited.
# NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Token mints (defaults are Circle's official addresses)
# NEXT_PUBLIC_EURC_MINT=HzwqbKZw8HxMN6bF2yFZNrht3c2iXXzpKcFu7uBEDKtr
# NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
